// DVFilter start
$_['entry_values']          		= 'Add the values ​​for this option.';
$_['tab_dvfilter']          		= 'DVFilter Options';
$_['dvfilter_select_category'] 	= 'To start, select a category for this product.';
// DVFilter end
      ]]></add>
    </operation>
  </file><!-- /admin/language/english/catalog/product.php -->

