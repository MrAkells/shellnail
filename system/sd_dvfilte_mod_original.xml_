	<file path="catalog/controller/startup/seo_url.php">
    <operation>
      <search><![CDATA[$this->url->addRewrite($this);]]></search>
      <add position="after"><![CDATA[
      // DVFilter start
      if (!is_null($this->registry->get('dvfilter'))) {
  			$this->url->addRewrite($this->registry->get('dvfilter'));
  		}
      // DVFilter end
      ]]></add>
    </operation>
  </file><!-- /catalog/controller/startup/seo_url.php -->

	<file path="catalog/controller/startup/seo_pro.php">
    <operation>
      <search><![CDATA[$this->url->addRewrite($this);]]></search>
      <add position="after"><![CDATA[
