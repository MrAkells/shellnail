	<file path="catalog/model/catalog/product.php">
    <operation>
      <search><![CDATA[if (!empty($data['filter_manufacturer_id'])) {]]></search>
      <add position="before"><![CDATA[
		// DVFilter start
		if (!empty($data['filter_dvfilter'])) {
      $this->load->config('dvfilter');
      $this->load->model('catalog/dvfilter');

      $dvfilter_product_sql = $this->model_catalog_dvfilter->getProductSQL($data['filter_dvfilter']);

			if ($dvfilter_product_sql) {
			  $sql .= $dvfilter_product_sql;
			}
		}
		// DVFilter end
      ]]></add>
    </operation>
	<!-- modification category filter -->
	  <operation>
		<search><![CDATA[$sql .= " AND p2c.category_id = '" . (int)$data['filter_category_id'] . "'";]]></search>
		<add position="replace"><![CDATA[
				// Replace category filter
				if(isset($data['filter_dvfilter']) and !empty($data['filter_dvfilter'])) {
					$sql .= $this->model_catalog_dvfilter->getCategorySQL($data['filter_dvfilter'], $data['filter_category_id']);
				} elseif ($data['filter_category_id'] != 'null') {
					$sql .= " AND p2c.category_id = '" . (int)$data['filter_category_id'] . "'";
				}
				// End replace category filter]]></add>
	  </operation>
	<!-- end modification category filter -->
  </file><!-- /catalog/model/catalog/product.php -->
  
	<file path="catalog/controller/product/category.php">
    <operation>
      <search index="0"><![CDATA[$data['breadcrumbs'] = array();]]></search>
      <add position="before"><![CDATA[
		// DVFilter start
    if (isset($this->request->get['filter_dvfilter'])) {
      $filter_dvfilter = $this->request->get['filter_dvfilter'];
		$data['is_filter_applied']=true;

		$edvfilter = explode(";", $filter_dvfilter);
		// if set in stock or count options > 2
		if(stripos($filter_dvfilter, 's:in') !== false || count($edvfilter) >= 1){
			$this->document->setNoindex(true);
		} else{
			foreach($edvfilter as $flr){
				$edvoptions = explode(",", $flr);
				if(count($edvoptions) > 1) {
					$this->document->setNoindex(true);
					break;
				}
			}
		}
		
    } else {
      $filter_dvfilter = '';
		$data['is_filter_applied']=false;
    }
		// DVFilter end
      ]]></add>
    </operation>

    <!-- Filter params to product model -->

    <operation>
      <search><![CDATA[$product_total =]]></search>
      <add position="before"><![CDATA[
  		// DVFilter start
  		$filter_data['filter_dvfilter'] = $filter_dvfilter;
  		// DVFilter end
      ]]></add>
    </operation>
    <operation>
      <search><![CDATA[$product_total =]]></search>
      <add position="after"><![CDATA[
  		// DVFilter start
  			if (isset($this->request->get['filter_dvfilter']) && $product_total == 0) {
				$this->load->controller('error/not_found');
				return;
			}
  		// DVFilter end
      ]]></add>
    </operation>

    <!-- Add url -->

    <operation>
      <search index="2"><![CDATA[if (isset($this->request->get['filter'])) {]]></search>
      <add position="before"><![CDATA[
      // DVFilter start
			if (isset($this->request->get['filter_dvfilter'])) {
				$url .= '&filter_dvfilter=' . $this->request->get['filter_dvfilter'];
			}
      // DVFilter end
      ]]></add>
    </operation>

    <operation>
      <search index="3"><![CDATA[if (isset($this->request->get['filter'])) {]]></search>
      <add position="before"><![CDATA[
      // DVFilter start
			if (isset($this->request->get['filter_dvfilter'])) {
				$url .= '&filter_dvfilter=' . $this->request->get['filter_dvfilter'];
			}
      // DVFilter end
      ]]></add>
    </operation>

    <operation>
      <search index="4"><![CDATA[if (isset($this->request->get['filter'])) {]]></search>
      <add position="before"><![CDATA[
      // DVFilter start
			if (isset($this->request->get['filter_dvfilter'])) {
				$url .= '&filter_dvfilter=' . $this->request->get['filter_dvfilter'];
			}
      // DVFilter end
      ]]></add>
    </operation>

    <!-- Canonical Fix -->
    <!--
    <operation>
      <search><![CDATA[if ($page == 1) {]]></search>
      <add position="before"><![CDATA[
      if (isset($this->request->get['page'])) {
      ]]></add>
    </operation>

    <operation>
      <search><![CDATA[if ($limit]]></search>
      <add position="before"><![CDATA[
      }
      ]]></add>
    </operation>
    -->
	  
	     <!-- SEO Meta -->

    <operation>
      <search limit="1"><![CDATA[$data['limit'] = $limit;]]></search>
      <add position="after"><![CDATA[
      // DVFilter Start
      $text_color = $this->language->get('text_color');
      $dvfilter_page_info = $this->load->controller('extension/module/dvfilter/getPageInfo');

      if ($dvfilter_page_info) {
        $this->document->setTitle($dvfilter_page_info['meta_title']);

        if ($dvfilter_page_info['meta_description']) {
			    $this->document->setDescription($dvfilter_page_info['meta_description']);
        }

        if ($dvfilter_page_info['meta_keyword']) {
			    $this->document->setKeywords($dvfilter_page_info['meta_keyword']);
        }

			  $data['heading_title'] = $dvfilter_page_info['title'];

        if ($dvfilter_page_info['description'] && !isset($this->request->get['page']) && !isset($this->request->get['sort']) && !isset($this->request->get['order']) && !isset($this->request->get['search']) && !isset($this->request->get['limit'])) {
        	$data['description'] = html_entity_decode($dvfilter_page_info['description'], ENT_QUOTES, 'UTF-8');
        }
      } else {
        $meta_title = $this->document->getTitle();
        $meta_description = $this->document->getDescription();
        $meta_keyword = $this->document->getKeywords();

        $filter_title = $this->load->controller('extension/module/dvfilter/getSelectedsFilterTitle');

        if ($filter_title) {
          if (false !== strpos($meta_title, '{filter}')) {
            $meta_title = trim(str_replace('{filter}', $filter_title, $meta_title));
          } else {
			$meta_title = "ᐉ ". $data['heading_title'] ." ". $filter_title . $this->language->get('text_meta_title');
            //$meta_title .= ' ' . $filter_title;
          }

          $this->document->setTitle($meta_title);

          if ($meta_description) {
            if (false !== strpos($meta_description, '{filter}')) {
              $meta_description = trim(str_replace('{filter}', $filter_title, $meta_description));
            } else {
              	$meta_description = $data['heading_title'] ." ". $filter_title . $this->language->get('text_meta_description1') ." (". $product_total ." товар" . ($product_total > 4 ?"ов": ($product_total == 1?"":"а")) . ") " . mb_convert_encoding("&#128142;",'utf-8', "HTML-ENTITIES") . $this->language->get('text_meta_description2');
				//$meta_description .= ' ' . $filter_title;
            }
				$this->document->setDescription($meta_description);
          }

          if ($meta_keyword) {
            if (false !== strpos($meta_keyword, '{filter}')) {
              $meta_keyword = trim(str_replace('{filter}', $filter_title, $meta_keyword));
            } else {
              $meta_keyword .= ' ' . $filter_title;
            }

           	$this->document->setKeywords($meta_keyword);
          }

          $heading_title = $data['heading_title'];

          if (false !== strpos($heading_title, '{filter}')) {
            $heading_title = trim(str_replace('{filter}', $filter_title, $heading_title));
          } else {
            $heading_title .= ' ' . $filter_title;
          }

          $data['heading_title'] = str_replace('color', $text_color, $heading_title);

          $data['description'] = '';
        } else {
          $this->document->setTitle(trim(str_replace('{filter}', '', $meta_title)));
          $this->document->setDescription(trim(str_replace('{filter}', '', $meta_description)));
          $this->document->setKeywords(trim(str_replace('{filter}', '', $meta_keyword)));

          $data['heading_title'] = trim(str_replace('{filter}', '', $data['heading_title']));
        }
      }
      if(!$this->document->isNoindex() && $filter_title){
          $data['breadcrumbs'][] = array(
            'text' => str_replace('color', $text_color, $filter_title),
            'href' => ''
          );
      }
      // DVFilter End
      ]]></add>
    </operation>
    <!-- <operation>
      <search index="0"><![CDATA[$this->document->addLink($this->url->link('product/category', 'path=' . $category_info['category_id'], true), 'canonical');]]></search>
      <add position="replace"><![CDATA[
		// DVFilter start
		if (isset($this->request->get['filter_dvfilter'])) {
		  $this->document->addLink($this->url->link('product/category', 'path=' . $category_info['category_id'].'&filter_dvfilter=' . $this->request->get['filter_dvfilter'], true), 'canonical');
		} else {
		  $this->document->addLink($this->url->link('product/category', 'path=' . $category_info['category_id'], true), 'canonical');
		}
		// DVFilter end
      ]]></add>
    </operation> -->
    <operation>
      <search index="1"><![CDATA[if ($page == 1) {]]></search>
      <add position="before"><![CDATA[
		// DVFilter start
    if (isset($this->request->get['filter_dvfilter'])){
        // is canonical
        $this->load->model('extension/module/page_no_index');
        if($this->model_extension_module_page_no_index->isPageCanonical()){
          $category_info['category_id'] = $category_info['category_id'].'&filter_dvfilter=' . $this->request->get['filter_dvfilter'];
        } else {
          // canonical for duplicate
          $this->load->model('catalog/dvfilter');
          $category_option = $this->model_catalog_dvfilter->getCategoryByOptions($filter_dvfilter);
          if($category_option){
            $category_info['category_id'] .= '_'. $category_option;
          }
        }
    }

    // DVFilter end
      ]]></add>
    </operation>    
  </file><!-- /catalog/controller/product/category.php -->
  
