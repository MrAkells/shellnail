<?xml version="1.0" encoding="utf-8"?>
<modification>
  <name>DVFilter Modification (With category filter)</name>
  <code>dvfilter-product-filter</code>
  <version>3.3</version>
  <author>Divotek</author>

  <!--
  **
  **
  ********* ADMIN **********
  **
  **
  -->

  <!-- CONTROLLERS -->

	<file path="admin/controller/catalog/product.php">
    <operation>
      <search><![CDATA[function getForm() {]]></search>
      <add position="after"><![CDATA[
    // DVFilter start
    $this->document->addStyle('view/stylesheet/dvfilter/dvfilter.css');
    $this->document->addScript('view/javascript/dvfilter/dvfilter.js');
    // DVFilter end
      ]]></add>
    </operation>
    <operation>
      <search><![CDATA[$data['tab_general'] = $this->language->get('tab_general');]]></search>
      <add position="after"><![CDATA[
    // DVFilter start
    $data['tab_dvfilter'] = $this->language->get('tab_dvfilter');
    $data['entry_values'] = $this->language->get('entry_values');
    $data['dvfilter_select_category'] = $this->language->get('dvfilter_select_category');
    // DVFilter end
      ]]></add>
    </operation>
  </file><!-- /admin/controller/catalog/product.php -->

	<file path="admin/controller/common/column_left.php">
    <operation>
      <search><![CDATA[if ($this->user->hasPermission('access', 'catalog/filter')) {]]></search>
      <add position="before"><![CDATA[
      // DVFilter start
			if ($this->user->hasPermission('access', 'catalog/dvfilter')) {
				$catalog[] = array(
					'name'	   => $this->language->get('text_dvfilter'),
					'href'     => $this->url->link('catalog/dvfilter', 'token=' . $this->session->data['token'], true),
					'children' => array()
				);
			}
		  // DVFilter end
      ]]></add>
    </operation>
  </file><!-- /admin/controller/common/column_left.php -->

  <!-- LANGUAGES -->

